# ── TrafficSense AI Backend Environment ──
# Copy this to .env and fill in your API keys.

# TomTom Traffic API (required for live traffic data)
TOMTOM_API_KEY=

# OpenWeather API (required for live weather data)
OPENWEATHER_API_KEY=

# Application environment: development | production
APP_ENV=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Congestion thresholds (optional, defaults shown)
# CONGESTION_LOW=0.25
# CONGESTION_MODERATE=0.50
# CONGESTION_HIGH=0.75

# ── AI Chatbot (AWS Bedrock) ──
# AWS credentials (or use ~/.aws/credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model ID
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Max conversation messages to retain
# CHATBOT_MAX_HISTORY=20
