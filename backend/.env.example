# ── TrafficSense AI Backend Environment ──
# Copy this to .env and fill in your API keys.

# TomTom Traffic API (required for live traffic data)
TOMTOM_API_KEY=

# OpenWeather API (required for live weather data)
OPENWEATHER_API_KEY=

# Application environment: development | production
APP_ENV=development

# Application metadata and debug flag (optional, defaults shown)
# APP_NAME=TrafficSense AI
# APP_VERSION=1.0.0
# DEBUG=True

# In-memory cache TTLs in seconds (optional, defaults shown)
# TRAFFIC_CACHE_TTL=120
# WEATHER_CACHE_TTL=300
# PREDICTION_CACHE_TTL=300
# ANALYTICS_CACHE_TTL=180

# Outbound API timeout in seconds (optional, default shown)
# API_TIMEOUT_SECONDS=10

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Congestion thresholds (optional, defaults shown)
# CONGESTION_LOW=0.25
# CONGESTION_MODERATE=0.50
# CONGESTION_HIGH=0.75

# ── AI Chatbot (AWS Bedrock) ──
# AWS credentials (or use ~/.aws/credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model ID
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Max conversation messages to retain
# CHATBOT_MAX_HISTORY=20

# Chatbot request timeout in seconds (optional, default shown)
# CHATBOT_REQUEST_TIMEOUT=30
